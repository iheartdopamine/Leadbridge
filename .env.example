# Copia este archivo como ".env" y completa los valores reales.
# "VITE_" es el prefijo obligatorio para que Vite exponga la variable
# al código del navegador.

# URL del Web App publicado desde Google Apps Script (Fase 3).
# El propio Apps Script reenvía a los webhooks de Discord/Slack, así
# no exponemos esas URLs en el bundle público del frontend.
VITE_GOOGLE_SHEETS_WEBAPP_URL=

# Nombre de la empresa/producto, usado en textos de la landing.
VITE_COMPANY_NAME="Tu Empresa"
